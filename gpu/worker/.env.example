# Set these values in the Vast.ai instance environment; never commit real values.
API_BASE_URL=https://api.example.com
WORKER_TOKEN=replace-with-at-least-32-random-characters
WORKER_ID=bekas-vast-gpu-01

POLL_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=20
REQUEST_TIMEOUT_SECONDS=30
MAX_CLAIM_SECONDS=600
MESH_TIMEOUT_SECONDS=300
MODEL_LOAD_TIMEOUT_SECONDS=900
MAX_INPUT_BYTES=5000000
MAX_GLB_BYTES=25000000

# Paths inside the Vast.ai container.
SF3D_PYTHON=/opt/venvs/sf3d/bin/python
SF3D_RUN_PY=/opt/stable-fast-3d/run.py
SF3D_MODEL_ID=stabilityai/stable-fast-3d
SF3D_VERSION=pin-a-tested-commit
TRIPOSR_PYTHON=/opt/venvs/triposr/bin/python
TRIPOSR_RUN_PY=/opt/TripoSR/run.py
TRIPOSR_MODEL_ID=stabilityai/TripoSR
TRIPOSR_VERSION=pin-a-tested-commit

# Required only if the selected Hugging Face model is gated.
HF_TOKEN=replace-with-read-only-token
