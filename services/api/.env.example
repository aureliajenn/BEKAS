# Supabase Postgres connection string; keep server credentials private.
DATABASE_URL=postgresql://postgres:replace-me@db.example.supabase.co:5432/postgres
DATABASE_SSL=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=bekas-assets
SIGNED_DOWNLOAD_URL_SECONDS=900
UPLOAD_PENDING_TTL_SECONDS=1800
MAX_UPLOAD_BYTES=5242880
MAX_GLB_BYTES=10485760
MAX_ACTIVE_PROJECTS=2
MAX_MESH_ATTEMPTS=2
MAX_JOB_ATTEMPTS=3

OPENAI_API_KEY=replace-me
TEXT_MODEL=gpt-6-luna
TEXT_FALLBACK_MODEL=gpt-6.1-sol
IMAGE_MODEL=gpt-image-2.5-flare

# Hosted mesh generation; one internal mesh consumer, no separate GPU worker.
SF3D_SPACE_ID=stabilityai/stable-fast-3d
HF_TOKEN=
MESH_ENABLED=true
MESH_JOB_TIMEOUT_SECONDS=600
MESH_POLL_SECONDS=3
MESH_RETRY_SECONDS=15
